PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nexora
JWT_SECRET=your_jwt_secret_here
CLIENT_ORIGIN=http://localhost:5173

# Optional — enables the AI progress summary feature (console.anthropic.com).
# If left blank, the app automatically falls back to a computed (non-AI) summary.
ANTHROPIC_API_KEY=

# Optional — override the AI model used for summaries (defaults to claude-haiku-5-5)
# ANTHROPIC_MODEL=
